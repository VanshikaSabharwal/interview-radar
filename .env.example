# Copy this file to .env and fill in your own values:
#   cp .env.example .env

# SearchApi key: https://www.searchapi.io/ (Dashboard -> API Key)
SEARCHAPI_API_KEY=

# Upstash Redis REST credentials: https://console.upstash.com/ (your database -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Groq API key for the AI (reads resumes): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: a different Groq model (must support structured outputs)
# AI_MODEL=openai/gpt-oss-120b

# Any long random string. Telegram sends it back on every webhook call.
# Generate one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Where applications run their browser:
#   local    = on this machine, using your installed Google Chrome (for testing)
#   (unset)  = in a Vercel Sandbox (needs `vercel link`, `vercel env pull`, `npm run setup-sandbox`)
# APPLY_RUNNER=local

# Optional: the public website (for Terms/Privacy links). On Vercel it's detected automatically.
# SITE_URL=https://your-app.vercel.app

# Any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=
